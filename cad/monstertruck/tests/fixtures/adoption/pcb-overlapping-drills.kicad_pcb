(kicad_pcb (general (thickness 1.6))
 (gr_rect (start 0 0) (end 20 -16) (layer "Edge.Cuts") (width 0.05) (tstamp edge))
 (footprint "fixture" (at 0 0) (tstamp footprint)
 (pad "0" np_thru_hole circle (at 9.5 -8) (size 2 2) (drill 2.0) (layers "*.Cu" "*.Mask") (tstamp pad-0))
(pad "1" np_thru_hole circle (at 10.5 -8) (size 2 2) (drill 2.0) (layers "*.Cu" "*.Mask") (tstamp pad-1))))
