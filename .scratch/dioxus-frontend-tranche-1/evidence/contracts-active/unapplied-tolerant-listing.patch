+fn saved_document_entry(value: JsValue) -> SavedDocumentEntry {
+    match serde_wasm_bindgen::from_value::<ProjectDoc>(value.clone()) {
+        Ok(document) => SavedDocumentEntry::Document(Box::new(document)),
+        Err(_) => {
+            let name = string_property(&value, "name");
+            match string_property(&value, "id") {
+                Some(id) => SavedDocumentEntry::PreviewUnavailable { id, name },
+                None => SavedDocumentEntry::IdentityUnavailable { name },
+            }
+        }
+    }
+}
+
+fn string_property(value: &JsValue, key: &str) -> Option<String> {
+    Reflect::get(value, &JsValue::from_str(key))
+        .ok()
+        .and_then(|property| property.as_string())
+}
