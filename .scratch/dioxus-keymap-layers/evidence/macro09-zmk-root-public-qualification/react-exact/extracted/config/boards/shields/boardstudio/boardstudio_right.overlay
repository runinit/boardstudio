/ { chosen { zmk,kscan = &kscan_combo; zmk,matrix-transform = &matrix_transform0; }; matrix_transform0: matrix_transform0 { compatible = "zmk,matrix-transform"; rows = <12>; columns = <6>; row-offset = <6>; map = <RC(0, 0) RC(0, 1) RC(0, 2) RC(0, 3) RC(0, 4) RC(0, 5) RC(1, 0) RC(1, 1) RC(1, 2) RC(1, 3) RC(1, 4) RC(1, 5) RC(2, 0) RC(2, 1) RC(2, 2) RC(2, 3) RC(2, 4) RC(2, 5) RC(3, 0) RC(3, 1) RC(3, 2) RC(3, 3) RC(3, 4) RC(3, 5) RC(4, 0) RC(4, 1) RC(4, 2) RC(4, 3) RC(4, 4) RC(5, 0) RC(6, 0) RC(6, 1) RC(6, 2) RC(6, 3) RC(6, 4) RC(6, 5) RC(7, 0) RC(7, 1) RC(7, 2) RC(7, 3) RC(7, 4) RC(7, 5) RC(8, 0) RC(8, 1) RC(8, 2) RC(8, 3) RC(8, 4) RC(8, 5) RC(9, 0) RC(9, 1) RC(9, 2) RC(9, 3) RC(9, 4) RC(9, 5) RC(10, 0) RC(10, 1) RC(10, 2) RC(10, 3) RC(10, 4) RC(11, 0)>; }; kscan0: kscan0 { compatible = "zmk,kscan-gpio-matrix"; wakeup-source; diode-direction = "col2row"; row-gpios = <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) &gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) &gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) &gpio1 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN) &gpio1 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>; col-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | 0) &gpio0 29 (GPIO_ACTIVE_HIGH | 0) &gpio0 2 (GPIO_ACTIVE_HIGH | 0) &gpio1 15 (GPIO_ACTIVE_HIGH | 0) &gpio1 13 (GPIO_ACTIVE_HIGH | 0) &gpio1 11 (GPIO_ACTIVE_HIGH | 0)>; }; kscan_extra: kscan_extra { compatible = "zmk,kscan-gpio-direct"; input-gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; }; kscan_combo: kscan_combo { compatible = "zmk,kscan-composite"; rows = <6>; columns = <6>; main { kscan = <&kscan0>; }; buttons { kscan = <&kscan_extra>; row-offset = <5>; }; }; };

&pro_micro_serial { status = "okay"; current-speed = <115200>; };
/ { wired_split { compatible = "zmk,wired-split"; device = <&pro_micro_serial>; }; };
&pinctrl { uart0_default: uart0_default { group1 { psels = <NRF_PSEL(UART_TX, 0, 6)>, <NRF_PSEL(UART_RX, 0, 8)>; }; }; };
&uart0 { pinctrl-0 = <&uart0_default>; pinctrl-names = "default"; status = "okay"; };

&i2c0 { status = "okay"; pinctrl-0 = <&boardstudio_i2c>; pinctrl-names = "default"; oled: ssd1306@3c { compatible = "solomon,ssd1306fb"; reg = <0x3c>; width = <128>; height = <32>; segment-offset = <0>; page-offset = <0>; display-offset = <0>; multiplex-ratio = <31>; segment-remap; com-invdir; com-sequential; inversion-on; prechargep = <0x22>; }; }; &pinctrl { boardstudio_i2c: boardstudio_i2c { group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 9)>, <NRF_PSEL(TWIM_SCL, 0, 10)>; }; }; }; / { chosen { zephyr,display = &oled; }; };
