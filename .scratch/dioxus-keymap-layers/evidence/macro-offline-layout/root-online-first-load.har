            "text": "@font-face {\n  font-family: 'Source Sans 3';\n  src: url('fonts/source-sans-3-upright.woff2') format('woff2');\n  font-style: normal;\n  font-weight: 200 900;\n  font-display: swap;\n}\n@font-face {\n  font-family: 'Source Code Pro';\n  src: url('fonts/source-code-pro-upright.woff2') format('woff2');\n  font-style: normal;\n  font-weight: 200 900;\n  font-display: swap;\n}\n:root {\n  color-scheme: light;\n  --wb-selection-ink: #253EAC; --wb-paper: #f7f8fa; --wb-canvas: #E9EEF2;\n  --wb-panel: #FFFFFF; --wb-raised: #e9eef2; --wb-surface-soft: #edf0f8;\n  --wb-surface-strong: #dce3ef; --wb-ink: #182331; --wb-muted: #576678;\n  --wb-subtle: #576678; --wb-rule: #dbe1e8; --wb-rule-strong: #9aaabc;\n  --wb-accent: #3858D6; --wb-accent-dark: #2945b6; --wb-accent-secondary: #8E5AA5;\n  --wb-teal: #3858D6; --wb-on-accent: #FFFFFF; --wb-topbar: #ffffff;\n  --wb-topbar-ink: #182331; --wb-selection-surface: #E9EDFF;\n  --wb-status-success: #226c50; --wb-status-success-surface: #e2f2e9;\n  --wb-status-warning: #8A4B00; --wb-status-warning-surface: #FFF1D9;\n  --wb-status-error: #a2191f; --wb-status-error-surface: #fff1f1;\n  --wb-grid-small: #d8e1e8; --wb-grid-large: #b0c0cd; --wb-geometry-outline: #596C86;\n  --wb-geometry-fill: #ddebe5; --wb-geometry-fill-muted: #e2e9f2;\n  --wb-geometry-key: #3858D6; --wb-geometry-part: #8E5AA5;\n  --wb-geometry-label: #182331; --wb-geometry-body: #f7f9fc;\n  --wb-geometry-board: #397568; --wb-geometry-graphic: #397568;\n  --wb-geometry-zone: #ddebe5; --wb-geometry-text: #8E5AA5;\n  --wb-mono: 'Source Code Pro', Consolas, monospace;\n  --wb-body: 'Source Sans 3', 'Segoe UI', sans-serif;\n  --wb-display: 'Source Sans 3', 'Segoe UI', sans-serif;\n  --wb-type-title: 23px; --wb-type-body: 13px; --wb-type-label: 12px;\n  --wb-leading-ui: 1.45; --wb-leading-copy: 1.55;\n  --wb-motion-feedback: 120ms; --wb-motion-reveal: 180ms; --wb-motion-panel: 220ms;\n  --wb-ease-out: cubic-bezier(.16, 1, .3, 1);\n}\n:root[data-theme='dark'] {\n  color-scheme: dark;\n  --wb-selection-ink: #CDD6FF; --wb-paper: #151c26; --wb-canvas: #101a22;\n  --wb-panel: #1c2632; --wb-raised: #293443; --wb-surface-soft: #263246;\n  --wb-surface-strong: #344562; --wb-ink: #EDF1F7; --wb-muted: #AFBCCB;\n  --wb-subtle: #AFBCCB; --wb-rule: #344151; --wb-rule-strong: #61738a;\n  --wb-accent: #9AADFF; --wb-accent-dark: #b6c4ff; --wb-accent-secondary: #B98CD1;\n  --wb-teal: #9AADFF; --wb-on-accent: #101725; --wb-topbar: #16222d;\n  --wb-topbar-ink: #EDF1F7; --wb-selection-surface: #304373;\n  --wb-status-success: #6ab99d; --wb-status-success-surface: #18352d;\n  --wb-status-warning: #F4BA68; --wb-status-warning-surface: #332A1D;\n  --wb-status-error: #ff8389; --wb-status-error-surface: #491217;\n  --wb-grid-small: #203040; --wb-grid-large: #344b60; --wb-geometry-outline: #6F87A3;\n  --wb-geometry-fill: #18352d; --wb-geometry-fill-muted: #223041;\n  --wb-geometry-key: #9AADFF; --wb-geometry-part: #B98CD1;\n  --wb-geometry-label: #EDF1F7; --wb-geometry-body: #223041;\n  --wb-geometry-board: #6AB99D; --wb-geometry-graphic: #6AB99D;\n  --wb-geometry-zone: #18352d; --wb-geometry-text: #B98CD1;\n}\n* { box-sizing: border-box; }\nhtml, body, #main { width: 100%; height: 100%; margin: 0; }\nbody { overflow: hidden; background: var(--wb-paper); color: var(--wb-ink); font: var(--wb-type-body)/var(--wb-leading-ui) var(--wb-body); }\nbutton, input, select { min-width: 0; color: inherit; background: var(--wb-panel); border: 1px solid var(--wb-rule-strong); border-radius: 4px; padding: 6px 9px; font: inherit; }\nbutton { min-height: 32px; cursor: pointer; }\nbutton:disabled { opacity: .5; cursor: default; }\nbutton:hover:not(:disabled) { border-color: var(--wb-accent); }\n:focus-visible { outline: 2px solid var(--wb-accent); outline-offset: 2px; }\nh1, h2, p { margin-top: 0; }\nh1 { font-size: 23px; line-height: 1.2; margin-bottom: 8px; }\nh2 { font-size: 13px; line-height: 1.3; margin: 0; font-weight: 650; }\n.m1-visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n.m1-workbench { display: flex; flex-direction: column; width: 100%; height: 100%; min-height: 0; overflow: hidden; }\n.m1-topbar { z-index: 3; flex: 0 0 44px; height: 44px; display: flex; align-items: stretch; gap: 12px; padding: 0 12px; background: var(--wb-topbar); border-bottom: 1px solid var(--wb-rule); color: var(--wb-topbar-ink); }\n.m1-brand { display: flex; align-items: center; justify-content: center; width: 30px; flex: 0 0 30px; margin: 0; color: var(--wb-accent); }\n.m1-brand svg { width: 22px; height: 22px; }\n.m1-project-menu { position: relative; display: flex; align-items: center; min-width: 0; }\n.m1-project-menu > summary { cursor: pointer; list-style: none; max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 5px 18px 5px 5px; font-size: 12px; }\n.m1-project-menu > summary::-webkit-details-marker { display: none; }\n.m1-project-menu > summary::after { content: ''; position: absolute; right: 4px; top: 11px; width: 5px; height: 5px; border-right: 1px solid currentColor; border-bottom: 1px solid currentColor; transform: rotate(45deg); color: var(--wb-muted); }\n.m1-project-menu[open] > summary { background: var(--wb-selection-surface); }\n.m1-project-menu[open] .m1-library { position: fixed; z-index: 10; top: 44px; left: 8px; width: min(740px, calc(100vw - 16px)); max-height: calc(100dvh - 52px); overflow: auto; box-shadow: 0 8px 24px #18233126; }\n.m1-library { display: grid; gap: 8px; padding: 12px; background: var(--wb-panel); border: 1px solid var(--wb-rule); }\n.m1-library button, .m1-library label { width: 100%; text-align: left; }\n.m1-library label { display: grid; gap: 4px; color: var(--wb-muted); }\n.m1-library-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; margin-bottom: 12px; }\n.m1-library-heading h2 { margin: 0; color: var(--wb-ink); font-size: 15px; font-weight: 600; }\n.m1-library-heading h2 span { margin-left: 5px; color: var(--wb-muted); font-size: 12px; font-weight: 400; }\n.m1-library-heading > span, .m1-library > p { color: var(--wb-muted); font-size: 12px; }\n.m1-library > p { margin: 12px 0; font-size: 13px; line-height: 1.5; }\n.m1-keyboard-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px 14px; }\n.m1-keyboard-card { min-width: 0; }\n.m1-library .m1-keyboard-tile { display: flex; min-width: 0; flex-direction: column; gap: 5px; padding: 0 0 8px; border: 0; border-radius: 4px; color: var(--wb-ink); text-align: left; background: transparent; cursor: pointer; }\n.m1-keyboard-card.is-current .m1-keyboard-preview { outline: 2px solid var(--wb-accent); outline-offset: -2px; }\n.m1-keyboard-preview { display: grid; place-items: center; width: 100%; height: 108px; margin-bottom: 4px; padding: 14px; border-radius: 4px; color: var(--wb-geometry-key); background: var(--wb-canvas); }\n.m1-keyboard-preview svg { width: 100%; height: 100%; max-width: 100%; }\n.m1-keyboard-preview rect { fill: var(--wb-geometry-body); stroke-width: 1; }\n.m1-keyboard-title { max-width: 100%; padding-inline: 6px; color: var(--wb-ink); font-size: 13px; font-weight: 600; overflow-wrap: anywhere; }\n.m1-keyboard-detail { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; padding-inline: 6px; color: var(--wb-muted); font-size: var(--wb-type-label); }\n.m1-keyboard-current { display: inline-flex; align-items: center; gap: 2px; color: var(--wb-accent); }\n.m1-keyboard-current svg { width: 12px; height: 12px; }\n.m1-keyboard-preview.is-empty { align-content: center; gap: 8px; color: var(--wb-muted); font-size: 12px; }\n.m1-keyboard-preview.is-empty svg { width: 30px; height: 30px; justify-self: center; }\n.m1-library-keyboard-icon, .m1-library-check-icon { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }\n.m1-library .m1-library-text-action { display: inline; width: auto; min-height: 32px; padding: 3px; border: 0; color: var(--wb-accent); background: transparent; cursor: pointer; font-size: 12px; }\n.m1-library-actions { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin-top: 8px; }\n.m1-library-actions label { grid-column: 1 / -1; }\n.m1-workflow-navigation { display: flex; align-items: stretch; flex: 1; min-width: 0; }\n.m1-workflow-tabs { display: flex; min-width: 0; }\n.m1-workflow-tabs button, .m1-export-tab { position: relative; display: flex; align-items: center; justify-content: center; gap: 8px; min-width: 74px; height: 44px; padding: 0 10px; border: 0; border-radius: 0; background: transparent; color: var(--wb-muted); white-space: nowrap; }\n.m1-workflow-tabs button[aria-selected='true'], .m1-export-tab[aria-pressed='true'] { color: var(--wb-accent-dark); font-weight: 650; }\n.m1-workflow-tabs button[aria-selected='true']::after, .m1-export-tab[aria-pressed='true']::after { content: ''; position: absolute; inset: auto 0 0; height: 2px; background: var(--wb-accent); }\n.m1-tab-icon { width: 16px; height: 16px; flex: none; }\n.m1-workspace-select { display: none; }\n.m1-export-tab { margin-left: auto; min-width: 70px; color: var(--wb-topbar-ink); }\n.m1-save-state { align-self: center; position: relative; padding-left: 12px; color: var(--wb-muted); font-size: 12px; white-space: nowrap; }\n.m1-save-state::before { content: ''; position: absolute; left: 1px; top: calc(50% - 3px); width: 6px; height: 6px; border-radius: 50%; background: var(--wb-status-success); }\n.m1-save-state[data-state='saving']::before, .m1-save-state[data-state='pending']::before { background: var(--wb-status-warning); }\n.m1-save-state[data-state='failed']::before { background: var(--wb-status-error); }\n.m1-theme-picker { display: flex; align-items: center; gap: 5px; color: var(--wb-muted); font-size: 12px; white-space: nowrap; }\n.m1-theme-picker select { max-width: 90px; padding: 4px 5px; font-size: 12px; }\n.m1-editor { display: flex; flex: 1; flex-direction: column; min-height: 0; }\n.m1-editor-body { --m1-left-panel-width: clamp(230px, 18.36vw, 307px); --m1-right-panel-width: clamp(310px, 25vw, 419px); position: relative; display: grid; grid-template-columns: var(--m1-left-track, 264px) minmax(0, 1fr) var(--m1-right-track, 360px); flex: 1; min-height: 0; overflow: hidden; }\n.m1-object-slot, .m1-inspector-slot { position: relative; display: block; min-width: 0; min-height: 0; }\n.m1-object-slot { grid-column: 1; grid-row: 1; }\n.m1-workspace-content { grid-column: 2; grid-row: 1; min-width: 0; }\n.m1-inspector-slot { grid-column: 3; grid-row: 1; }\n.m1-panel-content { position: relative; display: flex; flex-direction: column; width: 100%; height: 100%; min-width: 0; min-height: 0; overflow: visible; }\n.m1-panel-content > .m1-objects, .m1-panel-content > .m1-inspector { flex: 1; width: 100%; min-width: 0; min-height: 0; }\n.m1-panel-content > .m1-objects > header, .m1-panel-content > .m1-inspector > header { display: none; }\n.m1-panel-heading { position: relative; z-index: 2; display: flex; flex: 0 0 42px; align-items: center; justify-content: space-between; gap: 8px; padding: 0 10px; border-bottom: 1px solid var(--wb-rule); color: var(--wb-ink); background: var(--wb-panel); }\n.m1-panel-heading h2 { margin: 0; font-size: 14px; }\n.m1-panel-options-trigger { flex: none; padding: 4px 7px; font-size: 12px; }\n.m1-panel-options { position: absolute; z-index: 8; top: 38px; right: 6px; display: grid; gap: 2px; width: 168px; padding: 5px; border: 1px solid var(--wb-rule-strong); border-radius: 5px; background: var(--wb-panel); box-shadow: 0 8px 22px rgb(0 0 0 / 20%); }\n.m1-panel-options button { min-height: 34px; text-align: left; }\n.m1-panel-rail { position: absolute; z-index: 5; top: 38%; display: flex; align-items: center; justify-content: center; width: 32px; height: 118px; padding: 8px 4px; writing-mode: vertical-rl; border: 1px solid var(--wb-rule-strong); color: var(--wb-ink); background: var(--wb-panel); box-shadow: 2px 4px 14px rgb(0 0 0 / 12%); }\n.m1-panel-slot[data-side=\"objects\"] > .m1-panel-rail { left: 0; border-left: 0; border-radius: 0 6px 6px 0; }\n.m1-panel-slot[data-side=\"inspector\"] > .m1-panel-rail { right: 0; border-right: 0; border-radius: 6px 0 0 6px; transform: rotate(180deg); }\n@media (min-width: 761px) {\n  .m1-panel-slot[data-mode=\"autohide\"], .m1-panel-slot[data-mode=\"collapsed\"] { width: 32px; overflow: visible; z-index: 3; }\n  .m1-panel-slot[data-side=\"objects\"][data-mode=\"autohide\"] > .m1-panel-content, .m1-panel-slot[data-side=\"objects\"][data-mode=\"collapsed\"] > .m1-panel-content { position: absolute; top: 0; bottom: 0; left: 0; z-index: 4; width: var(--m1-left-panel-width); background: var(--wb-panel); transition: transform var(--wb-motion-panel) ease, visibility 0s; }\n  .m1-panel-slot[data-side=\"inspector\"][data-mode=\"autohide\"] > .m1-panel-content, .m1-panel-slot[data-side=\"inspector\"][data-mode=\"collapsed\"] > .m1-panel-content { position: absolute; top: 0; right: 0; bottom: 0; z-index: 4; width: var(--m1-right-panel-width); background: var(--wb-panel); transition: transform var(--wb-motion-panel) ease, visibility 0s; }\n  .m1-panel-slot[data-side=\"objects\"][data-mode=\"autohide\"][data-revealed=\"false\"] > .m1-panel-content, .m1-panel-slot[data-side=\"objects\"][data-mode=\"collapsed\"][data-revealed=\"false\"] > .m1-panel-content { visibility: hidden; pointer-events: none; transform: translateX(-100%); }\n  .m1-panel-slot[data-side=\"inspector\"][data-mode=\"autohide\"][data-revealed=\"false\"] > .m1-panel-content, .m1-panel-slot[data-side=\"inspector\"][data-mode=\"collapsed\"][data-revealed=\"false\"] > .m1-panel-content { visibility: hidden; pointer-events: none; transform: translateX(100%); }\n}\n@media (max-width: 1150px) {\n  .m1-editor-body { --m1-left-panel-width: 220px; --m1-right-panel-width: 300px; }\n}\n.m1-compact-panel-controls { display: none; }\n.m1-objects, .m1-inspector { display: flex; flex-direction: column; min-width: 0; min-height: 0; background: var(--wb-panel); }\n.m1-objects { border-right: 1px solid var(--wb-rule); }\n.m1-inspector { border-left: 1px solid var(--wb-rule); }\n.m1-objects > header, .m1-inspector > header { flex: 0 0 42px; display: flex; align-items: center; padding: 0 10px; border-bottom: 1px solid var(--wb-rule); }\n.m1-object-navigation { display: grid; gap: 7px; padding: 9px 10px; border-bottom: 1px solid var(--wb-rule); }\n.m1-object-navigation label { display: grid; grid-template-columns: 1fr; gap: 4px; color: var(--wb-muted); font-size: 12px; }\n.m1-object-navigation select { width: 100%; height: 30px; color: var(--wb-ink); }\n.m1-instance-selection { display: grid; gap: 4px; color: var(--wb-muted); font-size: 12px; }\n.m1-instance-choices { display: flex; flex-wrap: wrap; gap: 4px; }\n.m1-instance-choices button { flex: 1 1 auto; min-height: 36px; color: var(--wb-ink); text-align: left; overflow-wrap: anywhere; }\n.m1-instance-choices button[aria-pressed=\"true\"] { border-color: var(--wb-accent); background: var(--wb-selection-surface); }\n.m1-instance-choices button:focus-visible { outline: 2px solid var(--wb-accent); outline-offset: 2px; }\n.m1-object-tree { display: flex; flex: 1; flex-direction: column; min-height: 0; }\n.m1-object-tree-heading { display: flex; justify-content: space-between; gap: 8px; padding: 9px 10px; border-bottom: 1px solid var(--wb-rule); font-weight: 650; }\n.m1-object-tree-heading span { color: var(--wb-muted); font-weight: 400; white-space: nowrap; }\n.m1-component-list { display: grid; align-content: start; gap: 1px; min-height: 0; flex: 1; overflow: auto; overscroll-behavior: contain; padding: 3px 5px; }\n.m1-component-list .m1-component { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 31px; text-align: left; overflow-wrap: anywhere; border-color: transparent; background: transparent; }\n.m1-component-list .m1-component:hover { background: var(--wb-surface-soft); }\n.m1-component-list .m1-component.selected { border-color: var(--wb-accent); background: var(--wb-selection-surface); }\n.m1-object-kind { flex: none; margin-left: 8px; padding-left: 8px; border-left: 1px solid var(--wb-rule); color: var(--wb-muted); font-size: 12px; }\n.m1-object-tree-list { gap: 0; padding: 4px 0; }\n.m1-tree-row { display: flex; align-items: center; gap: 2px; min-height: 36px; min-width: 0; padding-right: 8px; }\n.m1-tree-disclosure, .m1-tree-spacer { display: grid; place-items: center; flex: none; width: 20px; height: 24px; min-height: 24px; padding: 0; border: 0; color: var(--wb-muted); background: transparent; }\n.m1-tree-disclosure { font-size: 14px; }\n.m1-tree-row .m1-component { flex: 1; justify-content: flex-start; min-width: 0; min-height: 32px; gap: 9px; padding: 0 5px; border-radius: 3px; }\n.m1-tree-glyph, .m1-tree-glyph svg { display: block; flex: none; width: 17px; height: 17px; color: var(--wb-muted); }\n.m1-tree-label { overflow: hidden; min-width: 0; color: var(--wb-ink); font-size: var(--wb-type-body); line-height: var(--wb-leading-ui); text-overflow: ellipsis; white-space: nowrap; }\n.m1-tree-row .m1-object-kind { overflow: hidden; flex: 0 1 auto; min-width: 0; margin-left: auto; padding-left: 0; border: 0; font: var(--wb-type-label)/var(--wb-leading-ui) var(--wb-body); text-overflow: ellipsis; white-space: nowrap; }\n.m1-tree-row .m1-component.selected :is(.m1-tree-label, .m1-tree-glyph, .m1-object-kind) { color: var(--wb-selection-ink); }\n.m1-selected-context { padding: 14px 12px; border-bottom: 1px solid var(--wb-rule); }\n.m1-selected-context h2 { margin: 0; font-size: 16px; font-weight: 600; }\n.m1-selected-context p { margin: 8px 0 0; color: var(--wb-muted); }\n.m1-parts-library { display: flex; flex: 1; flex-direction: column; min-height: 0; padding: 16px 12px; color: var(--wb-ink); }\n.m1-parts-library > h2 { margin: 0 0 16px; font-size: 20px; }\n.m1-parts-search-label { display: grid; gap: 6px; color: var(--wb-muted); font: 500 var(--wb-type-label)/var(--wb-leading-ui) var(--wb-body); }\n.m1-parts-search { box-sizing: border-box; width: 100%; min-height: 34px; padding: 7px 8px; border: 1px solid var(--wb-rule-strong); border-radius: 3px; color: var(--wb-ink); background: var(--wb-panel); font: var(--wb-type-body)/var(--wb-leading-ui) var(--wb-body); }\n.m1-parts-search:focus-visible { outline: 2px solid var(--wb-accent); outline-offset: 1px; }\n.m1-parts-search::placeholder { color: var(--wb-muted); opacity: 1; }\n.m1-parts-catalogue-scroll { overflow: auto; min-height: 0; margin-top: 12px; }\n.m1-parts-catalogue-scroll > summary { padding: 10px 0; color: var(--wb-ink); cursor: pointer; font-weight: 600; }\n.m1-parts-catalogue-scroll > summary small { margin-left: 6px; color: var(--wb-muted); }\n.m1-parts-category h3 { margin: 14px 0 4px; color: var(--wb-muted); font-size: var(--wb-type-label); }\n.m1-parts-catalogue-choice { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 34px; padding: 7px 8px; border: 1px solid transparent; border-radius: 3px; color: var(--wb-ink); background: transparent; text-align: left; cursor: pointer; font-size: var(--wb-type-body); }\n.m1-parts-catalogue-choice:hover { background: var(--wb-raised); }\n.m1-parts-catalogue-choice[aria-selected=\"true\"] { border-color: var(--wb-accent); background: var(--wb-selection-surface); }\n.m1-parts-catalogue-choice:focus-visible { outline: 2px solid var(--wb-accent); outline-offset: -2px; }\n.m1-parts-empty, .m1-parts-loading, .m1-parts-load-error { margin: 12px 0; color: var(--wb-muted); font-size: var(--wb-type-body); line-height: 1.5; }\n.m1-parts-load-error { color: var(--wb-status-error); }\n.m1-parts-inspector { display: flex; flex: 1; flex-direction: column; min-width: 0; min-height: 0; overflow: auto; padding: 16px; color: var(--wb-ink); }\n.m1-parts-details h2 { margin: 0; font-size: 18px; }\n.m1-parts-details > p { color: var(--wb-muted); font-size: var(--wb-type-label); }\n.m1-parts-detail-list { display: grid; grid-template-columns: minmax(90px, 0.8fr) minmax(0, 1.2fr); gap: 8px 12px; margin: 18px 0 0; padding-top: 14px; border-top: 1px solid var(--wb-rule); font-size: var(--wb-type-label); line-height: 1.45; }\n.m1-parts-detail-list dt { color: var(--wb-muted); }\n.m1-parts-detail-list dd { min-width: 0; margin: 0; overflow-wrap: anywhere; color: var(--wb-ink); }\n.m1-parts-detail-list code { font-family: var(--wb-mono); }\n.m1-workspace-content { position: relative; display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: auto; background: var(--wb-canvas); container-type: inline-size; }\n.m1-canvas-toolbar { z-index: 1; position: absolute; top: 12px; left: 12px; right: 12px; display: flex; align-items: center; gap: 8px; min-height: 42px; width: fit-content; max-width: calc(100% - 24px); padding: 4px 8px; border: 1px solid var(--wb-rule-strong); border-radius: 8px; background: var(--wb-panel); box-shadow: 0 4px 16px #18233120; }\n.m1-canvas-toolbar span { padding: 0 8px; }\n.m1-save-error { max-width: min(44vw, 440px); margin: 0; color: var(--wb-status-error); font-size: 12px; }\n.m1-canvas { display: block; width: 100%; height: 100%; min-height: 250px; background: var(--wb-canvas); touch-action: none; }\n.m1-outline { fill: var(--wb-geometry-fill); stroke: var(--wb-geometry-board); stroke-width: .3; }\n.m1-outline.is-hole { fill: var(--wb-canvas); stroke: var(--wb-status-error); stroke-dasharray: .8 .55; }\n.m1-matrix-key { fill: color-mix(in srgb, var(--wb-geometry-fill-muted) 55%, transparent); stroke: var(--wb-geometry-outline); stroke-width: .28; pointer-events: none; }\n.m1-matrix-key.is-selected { fill: var(--wb-selection-surface); stroke: var(--wb-accent); stroke-width: .42; }\n.m1-part { fill: var(--wb-geometry-body); stroke: var(--wb-geometry-part); stroke-width: .4; cursor: grab; }\n.m1-part.selected { fill: var(--wb-selection-surface); stroke: var(--wb-accent); stroke-width: .8; }\n.m1-scene-part { cursor: grab; }\n.m1-part-label { font: 1.8px var(--wb-mono); fill: var(--wb-geometry-label); pointer-events: none; }\n.m1-part-pad { fill: var(--wb-geometry-part); stroke: none; }\n.m1-part-drill { fill: var(--wb-canvas); stroke: var(--wb-geometry-outline); stroke-width: .1; }\n.m1-footprint-graphic { fill: none; stroke: var(--wb-geometry-graphic); stroke-width: .15; stroke-linecap: round; stroke-linejoin: round; pointer-events: none; }\n.m1-footprint-zone { fill: var(--wb-geometry-zone); stroke: var(--wb-geometry-graphic); stroke-width: .12; pointer-events: none; }\n.m1-footprint-keepout { fill: none; stroke: var(--wb-geometry-graphic); stroke-width: .12; stroke-dasharray: .5 .5; pointer-events: none; }\n.m1-footprint-text { fill: var(--wb-geometry-label); font: .8px var(--wb-mono); pointer-events: none; }\n.m1-footprint-graphics-error { fill: var(--wb-status-error); font: 1.5px var(--wb-body); pointer-events: none; }\n.m1-keycap-overlay { pointer-events: none; }\n.m1-keycap-overlay rect { fill: var(--wb-geometry-body); fill-opacity: .75; stroke: var(--wb-geometry-outline); stroke-width: .22; }\n.m1-keycap-overlay .m1-keycap-top { fill-opacity: .25; stroke-width: .14; }\n.m1-keycap-overlay.is-selected rect { stroke: var(--wb-accent); fill: var(--wb-selection-surface); }\n.m1-part-hit-area { fill: transparent; stroke: none; pointer-events: all; cursor: grab; }\n.m1-canvas-toolbar .m1-footprints-toggle { padding: 4px 8px; font-size: 12px; }\n.m1-canvas-toolbar .m1-footprints-toggle[aria-pressed='true'] { color: var(--wb-accent-dark); border-color: var(--wb-accent); background: var(--wb-selection-surface); }\n.m1-layers { position: absolute; z-index: 2; right: 14px; bottom: 14px; display: flex; flex-direction: column; width: 192px; max-height: min(420px, calc(100% - 28px)); overflow: hidden; border: 1px solid var(--wb