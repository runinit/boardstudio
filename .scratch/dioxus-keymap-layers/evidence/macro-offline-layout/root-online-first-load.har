px; }\n.m1-editor-footer span:last-child { margin-left: auto; }\n.m1-case-panel { display: flex; flex-direction: column; gap: 10px; min-height: 100%; padding: 20px; background: var(--wb-canvas); }\n.m1-case-panel h2, .m1-case-panel p { margin: 0; }\n.m1-case-panel label { display: grid; grid-template-columns: minmax(140px, 220px) minmax(100px, 180px); align-items: center; gap: 8px; }\n.m1-case-bodies, .m1-case-bodies-generated { display: flex; flex-direction: column; align-content: start; gap: 14px; min-width: 0; flex: 1; min-height: 0; overflow: auto; padding: 16px 12px; color: var(--wb-ink); background: var(--wb-panel); }\n.m1-case-bodies h2, .m1-case-bodies h3 { margin: 0; color: var(--wb-ink); }\n.m1-case-bodies button { min-height: 36px; padding: 6px 10px; border: 1px solid var(--wb-rule-strong); border-radius: 4px; color: var(--wb-ink); background: var(--wb-panel); font: inherit; cursor: pointer; }\n.m1-case-bodies button:hover:not(:disabled) { background: var(--wb-raised); }\n.m1-case-bodies button:focus-visible, .m1-case-bodies :is(input, select):focus-visible { outline: 2px solid var(--wb-accent); outline-offset: 2px; }\n.m1-case-bodies button:disabled, .m1-case-bodies :is(input, select):disabled { opacity: .58; cursor: not-allowed; }\n.m1-case-bodies-heading, .m1-case-subsection-heading { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\n.m1-case-bodies-heading { padding-bottom: 10px; border-bottom: 1px solid var(--wb-rule); }\n.m1-case-body-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(112px, 1fr)); gap: 6px; }\n.m1-case-body-tab { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 2px 8px; text-align: left; }\n.m1-case-body-tab > span { grid-row: span 2; color: var(--wb-muted); font-variant-numeric: tabular-nums; }\n.m1-case-body-tab strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.m1-case-body-tab small, .m1-case-subsection-heading small { color: var(--wb-muted); font-size: var(--wb-type-label); }\n.m1-case-body-tab.is-active { border-color: var(--wb-accent); background: var(--wb-selection-surface); }\n.m1-case-body-editor, .m1-case-subsection { display: grid; gap: 10px; min-width: 0; padding: 12px 0; border-top: 1px solid var(--wb-rule); }\n.m1-case-bodies .m1-case-select { display: grid; gap: 5px; color: var(--wb-muted); font-size: var(--wb-type-label); }\n.m1-case-bodies select, .m1-case-number input { box-sizing: border-box; width: 100%; min-width: 0; min-height: 36px; padding: 6px 8px; border: 1px solid var(--wb-rule-strong); border-radius: 4px; color: var(--wb-ink); background: var(--wb-panel); font: inherit; }\n.m1-case-measures { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }\n.m1-case-number { display: grid; align-content: start; gap: 5px; min-width: 0; color: var(--wb-muted); font-size: var(--wb-type-label); }\n.m1-case-number-input { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 6px; }\n.m1-case-number-input small { color: var(--wb-muted); }\n.m1-case-number.has-error input { border-color: var(--wb-status-error); }\n.m1-case-field-error, .m1-case-edit-error { color: var(--wb-status-error); }\n.m1-case-mismatch { display: grid; gap: 8px; padding: 12px; border: 1px solid var(--wb-rule); border-radius: 5px; background: var(--wb-raised); }\n.m1-case-mismatch p, .m1-case-bodies-empty, .m1-case-bodies-note { margin: 0; color: var(--wb-muted); line-height: 1.5; }\n.m1-case-mount-editor { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; min-width: 0; padding: 10px; border: 1px solid var(--wb-rule); border-radius: 5px; }\n.m1-case-mount-editor legend { color: var(--wb-ink); font-weight: 600; }\n.m1-case-mount-editor > .m1-case-select, .m1-case-mount-editor > .m1-case-measures { grid-column: 1 / -1; }\n.m1-case-mount-editor > button { justify-self: end; }\n.m1-case-edit-pending, .m1-case-edit-saved { margin: 0