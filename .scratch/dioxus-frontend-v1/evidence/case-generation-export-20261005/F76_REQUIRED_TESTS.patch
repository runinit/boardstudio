+
+// Keep mounted Case readiness tests on the production owner/predicate path.
+// This bridge only assembles the same hook inputs as Editor; it does not copy
+// or replace mechanical_settings_mount's readiness rule.
+#[cfg(all(test, target_arch = "wasm32"))]
+pub(crate) fn use_case_generation_readiness_test_bridge(runtime: Rc<Runtime>) -> bool {
+    let adapter = use_context::<selection::SelectionAdapter>();
+    let WorkspaceState(workspace) = use_context::<WorkspaceState>();
+    let instance_selection = use_context::<InstanceSelection>();
+    let case_selection = use_context::<case_viewer::CaseSelection>();
+    mechanical_settings_mount::use_mechanical_settings_mount(
+        runtime,
+        adapter.generation,
+        workspace,
+        instance_selection,
+        case_selection,
+        EventHandler::new(|_| {}),
+    )
+    .generation_ready
+}

