+#[test]
+fn queued_position_axis_edits_preserve_prior_axis_and_undo_in_sequence() {
+    let mut session = Session::new();
+    let mut engine = CoreEngine::new();
+    let mut document = fixture();
+    document.parts[0].pose.at = Vec2 {
+        x: 66.675,
+        y: -47.625,
+    };
+    let effects = session.submit(Event::Open {
+        operation_id: OperationId(1),
+        document,
+    });
+    let (opened, _) = settle_core_and_save(&mut session, &mut engine, effects);
+    assert_eq!(opened.revision, 0);
+
+    // The UI's X edit is an absolute MoveParts command built from revision 0.
+    let first = session.submit(Event::Edit {
+        operation_id: OperationId(2),
+        command: EditCommand {
+            base_revision: 0,
+            transaction_id: "component-x".into(),
+            phase: EditPhase::Commit,
+            target_ids: vec!["key".into()],
+            operation: EditOperation::MoveParts {
+                positions: vec![Position {
+                    id: "key".into(),
+                    at: Vec2 { x: 60.0, y: -47.625 },
+                }],
+            },
+        },
+    });
+    let (first_id, first_epoch, first_request) = core_effect(&first);
+    let first_reply = engine.handle(first_request);
+    let first_save_effects = session.complete(Completion::Core {
+        request_id: first_id,
+        executor_epoch: first_epoch,
+        reply: Box::new(first_reply),
+    });
+    let (first_save_id, first_saved) = save_effect(&first_save_effects);
+    assert_eq!(first_saved.parts[0].pose.at, Vec2 { x: 60.0, y: -47.625 });
+
+    // Before that save completes, the Y field emits an absolute position based
+    // on the still-accepted revision 0, so its X member is stale by construction.
+    let second = session.submit(Event::Edit {
+        operation_id: OperationId(3),
+        command: EditCommand {
+            base_revision: 0,
+            transaction_id: "component-y".into(),
+            phase: EditPhase::Commit,
+            target_ids: vec!["key".into()],
+            operation: EditOperation::MoveParts {
+                positions: vec![Position {
+                    id: "key".into(),
+                    at: Vec2 { x: 66.675, y: -40.0 },
+                }],
+            },
+        },
+    });
+    assert!(!second.iter().any(|effect| matches!(effect, Effect::Core { .. })));
+
+    // The first document is not accepted until persistence commits; completing
+    // that barrier dispatches the queued Y intent at the next durable revision.
+    let second_effects = session.complete(Completion::Persist {
+        save_attempt_id: first_save_id,
+        result: SaveResult::Committed,
+    });
+    let (second_id, second_epoch, second_request) = core_effect(&second_effects);
+    assert!(matches!(&second_request, CoreRequest::Edit { command, .. } if command.base_revision == 1));
+    let second_reply = engine.handle(second_request);
+    let second_save_effects = session.complete(Completion::Core {
+        request_id: second_id,
+        executor_epoch: second_epoch,
+        reply: Box::new(second_reply),
+    });
+    let (second_save_id, final_saved) = save_effect(&second_save_effects);
+    let persisted_pose = final_saved.parts[0].pose.at;
+    session.complete(Completion::Persist {
+        save_attempt_id: second_save_id,
+        result: SaveResult::Committed,
+    });
+    let accepted_pose = session
+        .read_model()
+        .accepted
+        .as_ref()
+        .unwrap()
+        .document
+        .parts[0]
+        .pose
+        .at;
+
+    let undo = session.submit(Event::Undo {
+        operation_id: OperationId(4),
+    });
+    let (undo_saved, _) = settle_core_and_save(&mut session, &mut engine, undo);
+    assert_eq!(
+        (persisted_pose, accepted_pose, undo_saved.parts[0].pose.at),
+        (
+            Vec2 { x: 60.0, y: -40.0 },
+            Vec2 { x: 60.0, y: -40.0 },
+            Vec2 { x: 60.0, y: -47.625 },
+        ),
+        "the queued Y edit must preserve the prior X in durable and accepted state, and one Undo must reverse only Y"
+    );
+}
