+    #[wasm_bindgen_test]
+    async fn resize_and_dpr_changes_update_backing_size_and_rearm_the_resolution_listener() {
+        let _dpr = DevicePixelRatioOverride::install(1.0);
+        let spy = ListenerSpy::install();
+        let baseline = spy.live_listeners();
+        let renderer = scripted_renderer("");
+        let canvas = make_canvas();
+        let (status, _) = status_log();
+        let host = attach(&renderer, &canvas, status).expect("scripted renderer attaches");
+
+        assert_eq!(canvas.client_width(), 200);
+        assert_eq!(canvas.client_height(), 100);
+        assert_eq!(canvas.width(), 200);
+        assert_eq!(canvas.height(), 100);
+        assert_eq!(canvas.get_attribute("data-dpr").as_deref(), Some("1"));
+        assert_eq!(calls(&renderer, "resize"), 1, "initial backing size is applied");
+        assert_eq!(resize_argument(&renderer, 0), 200);
+        assert_eq!(resize_argument(&renderer, 1), 100);
+
+        canvas
+            .set_attribute("style", "width:240px;height:120px;display:block")
+            .unwrap();
+        web_sys::window()
+            .unwrap()
+            .dispatch_event(&web_sys::Event::new("resize").unwrap())
+            .unwrap();
+        settle().await;
+        assert_eq!(canvas.width(), 240);
+        assert_eq!(canvas.height(), 120);
+        assert_eq!(calls(&renderer, "resize"), 2, "CSS resize reaches the renderer");
+        assert_eq!(resize_argument(&renderer, 2), 240);
+        assert_eq!(resize_argument(&renderer, 3), 120);
+
+        let old_query = host
+            .inner
+            .dpr_query
+            .borrow()
+            .as_ref()
+            .expect("mount arms a DPR query")
+            .clone();
+        _dpr.set(2.0);
+        old_query
+            .dispatch_event(&web_sys::Event::new("change").unwrap())
+            .unwrap();
+        settle().await;
+        assert_eq!(canvas.width(), 480);
+        assert_eq!(canvas.height(), 240);
+        assert_eq!(canvas.get_attribute("data-dpr").as_deref(), Some("2"));
+        assert_eq!(calls(&renderer, "resize"), 3, "DPR change reaches the renderer");
+        assert_eq!(resize_argument(&renderer, 4), 480);
+        assert_eq!(resize_argument(&renderer, 5), 240);
+
+        let current_query = host
+            .inner
+            .dpr_query
+            .borrow()
+            .as_ref()
+            .expect("DPR change rearms the resolution query")
+            .clone();
+        old_query
+            .dispatch_event(&web_sys::Event::new("change").unwrap())
+            .unwrap();
+        settle().await;
+        assert_eq!(calls(&renderer, "resize"), 3, "old query listener was removed");
+        assert_ne!(old_query.media(), current_query.media());
+
+        drop(host);
+        assert_eq!(spy.live_listeners(), baseline, "resize and DPR listeners released");
+        assert_eq!(spy.live_observers(), 0, "resize observer disconnected");
+        canvas.remove();
+    }
