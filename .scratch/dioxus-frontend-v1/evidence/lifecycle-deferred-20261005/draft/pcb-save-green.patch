+            net_ids: Vec::new(),
+            thickness: 1.6,
+            traces: Vec::new(),
+            vias: Vec::new(),
+        });
+        document.module_definitions.push(ModuleDefinition {
+            id: "definition-collision".into(),
+            catalogue_row: None,
+            name: "Test module".into(),
+            family: "test".into(),
+            variant: "test".into(),
+            source: HardwareSource {
+                repository: "test".into(),
+                revision: "1".into(),
+                path: "test.module.json".into(),
+                license: "test".into(),
+                sha256: None,
+                upstream_status: None,
+            },
+            board: ModuleBoard {
+                contours: Vec::new(),
+                holes: Vec::new(),
+                thickness: Some(1.6),
+            },
+            mounts: Vec::new(),
+            volumes: Vec::new(),
+            openings: Vec::new(),
+            models: Vec::new(),
+            candidate_models: Vec::new(),
+            gates: Vec::new(),
+            interfaces: Vec::new(),
+            electrical: ModuleElectrical {
+                protocol: ModuleProtocol::Nonstandard,
+                required_signals: Vec::new(),
+                logic_voltage: None,
+                current_ma: None,
+                i2c_address: None,
+                pullup_ohms: None,
+                driver: None,
+                rotary_profile: None,
