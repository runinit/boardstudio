+                        }
+                    }
+                    DimensionField {
+                        identity: props.identity.clone(), request_sequence: props.request_sequence,
+                        on_request: props.on_request, feedback: props.feedback.clone(),
+                        field: MechanicalDimension::OpeningBottomZ, label: "Bottom Z", value: opening.z,
